{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@safer/property-types/*": ["./src/property-types/*"],
      "@safer/spec/*": ["./src/spec/*"],
      "@safer/source/*": ["./src/source/*"],
      "@safer/commands/*": ["./src/commands/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
