{
  "name": "@chughtapan/safer-spec-development",
  "version": "0.0.0",
  "description": "Per-folder SPEC.md TypeScript codemod. Generates structured specs from source + JSDoc directives; validates kind-coverage + classifier-coverage + precondition-pass-rate against fast-check property tests.",
  "type": "module",
  "license": "MIT",
  "author": "Tapan Chugh",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "safer-spec": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/**", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src"
  },
  "dependencies": {
    "@chughtapan/safer-spec-core": "workspace:*",
    "@effect/cli": "^0.73.0",
    "@effect/platform": "^0.96.0",
    "@effect/platform-node": "^0.106.0",
    "effect": "^3.21.0"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
