{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@safer/kinds/*": ["./src/kinds/*"],
      "@safer/authoring/*": ["./src/authoring/*"],
      "@safer/spec/*": ["./src/spec/*"],
      "@safer/source/*": ["./src/source/*"],
      "@safer/sidecar/*": ["./src/sidecar/*"],
      "@safer/modes/*": ["./src/modes/*"],
      "@safer/cli/*": ["./src/cli/*"]
    }
  },
  "include": ["src/**/*"]
}
