{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@safer/property-types/*": ["./src/property-types/*"],
      "@safer/authoring/*": ["./src/authoring/*"],
      "@safer/spec/*": ["./src/spec/*"],
      "@safer/source/*": ["./src/source/*"],
      "@safer/commands/*": ["./src/commands/*"]
    }
  },
  "include": ["src/**/*"]
}
